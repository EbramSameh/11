{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() == auth.uid) || (data.exists() && data.child('hostUid').val() == auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['name']) && newData.numChildren() == 1 && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 18"
          }
        },
        "scores": {
          "$uid": {
            ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostUid').val()"
          },
          ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostUid').val()"
        },
        "responses": {
          "$questionIndex": {
            ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostUid').val()",
            "$uid": {
              ".write": "auth != null && ((auth.uid == $uid && !data.exists() && newData.exists()) || auth.uid == root.child('rooms').child($roomId).child('hostUid').val())",
              ".validate": "!newData.exists() || (newData.hasChildren(['choice']) && newData.numChildren() == 1 && newData.child('choice').isNumber() && newData.child('choice').val() >= 0 && newData.child('choice').val() <= 3)"
            }
          },
          ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostUid').val()"
        }
      }
    }
  }
}